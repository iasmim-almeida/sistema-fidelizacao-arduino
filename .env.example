# ==============================================================================
# FIDELIZA - Arquivo de Exemplo de Configuração de Ambiente (.env.example)
# Copie este arquivo para .env e ajuste os valores conforme seu ambiente.
# NUNCA comite o arquivo .env com credenciais reais no controle de versão.
# ==============================================================================

# Chave secreta da aplicação Flask (essencial para sessões seguras e CSRF)
# Gere uma chave forte via terminal: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# String de conexão com o banco de dados (SQLite para desenvolvimento, PostgreSQL para produção)
# Exemplo SQLite: sqlite:///fidelizacao.db
# Exemplo PostgreSQL: postgresql+psycopg2://usuario:senha@localhost:5432/fidelizadb
DATABASE_URL=sqlite:///fidelizacao.db

# Ambiente de execução: 'development', 'production' ou 'testing'
FLASK_ENV=development

# Fator de conversão: quantidade de pontos gerados por cada R$ 1,00 gasto
PONTOS_POR_REAL=1

# Fuso horário padrão da aplicação para cálculo de expiração de recompensas
TIMEZONE=America/Sao_Paulo

# Chave pré-compartilhada para autenticação do terminal físico ESP8266 (Header X-Device-Key)
IOT_DEVICE_KEY=troque-por-uma-chave-de-dispositivo-forte

# Configuração de rede do servidor Flask de desenvolvimento
HOST=127.0.0.1
PORT=5000
